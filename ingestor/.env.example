# Copy this file to .env and fill in the values.

# --- AWS (IAM user: rag-ingestor-user) ---
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Uploaded files ---
S3_BUCKET_NAME=priya-genai-rag-docs-2026
S3_UPLOAD_PREFIX=uploads/
MAX_FILE_MB=20

# --- Chunking ---
# Characters per chunk, and how many characters neighbouring chunks share
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings (Amazon Bedrock) ---
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
# Parallel embedding calls per file
EMBEDDING_CONCURRENCY=8

# --- Vector store (Amazon OpenSearch) ---
OPENSEARCH_ENDPOINT=https://search-rag-opensearch-poc-6vldw2bfgkjhwyp5zvogpb7ami.ap-southeast-2.es.amazonaws.com
OPENSEARCH_INDEX=kb-chunks

# --- File status (DynamoDB) ---
DOCUMENTS_TABLE_NAME=documents
