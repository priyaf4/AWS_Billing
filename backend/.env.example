# Copy this file to .env and fill in the values.

# bedrock = Claude through Amazon Bedrock (uses AWS keys)
# anthropic = Claude API directly (uses ANTHROPIC_API_KEY)
LLM_PROVIDER=bedrock

# --- Amazon Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Claude API (only if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# --- Model ---
# Bedrock IDs look like global.anthropic.claude-haiku-4-5-20251001-v1:0
# Claude API IDs look like claude-haiku-4-5-20251001
CLAUDE_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# low | medium | high | xhigh | max. Leave EMPTY for Haiku 4.5 (it doesn't support effort).
CLAUDE_EFFORT=

# --- Chat history (DynamoDB, uses the AWS settings above) ---
CHAT_TABLE_NAME=chat-history
# Earlier messages sent to Claude with each question
CHAT_HISTORY_LIMIT=20

# --- RAG: knowledge base built by the ingestor (leave OPENSEARCH_ENDPOINT empty to answer without documents) ---
OPENSEARCH_ENDPOINT=https://search-rag-opensearch-poc-6vldw2bfgkjhwyp5zvogpb7ami.ap-southeast-2.es.amazonaws.com
OPENSEARCH_INDEX=kb-chunks
# Must match the ingestor
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
# Passages per question, and the relevance cutoff (score = 1 + cosine similarity)
RAG_TOP_K=5
RAG_MIN_SCORE=1.15
CLAUDE_MAX_TOKENS=1024
