# Copy this file to .env and fill in the values.

# bedrock = Claude through Amazon Bedrock (uses AWS keys)
# anthropic = Claude API directly (uses ANTHROPIC_API_KEY)
LLM_PROVIDER=bedrock

# --- Amazon Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Claude API (only if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# --- Model ---
# Bedrock IDs look like global.anthropic.claude-haiku-4-5-20251001-v1:0
# Claude API IDs look like claude-haiku-4-5-20251001
CLAUDE_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# low | medium | high | xhigh | max. Leave EMPTY for Haiku 4.5 (it doesn't support effort).
CLAUDE_EFFORT=
CLAUDE_MAX_TOKENS=1024
